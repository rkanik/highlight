{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hilvox",
  "mainBinaryName": "Hilvox",
  "version": "0.1.0",
  "identifier": "com.rkanik.hilvox",
  "build": {
    "beforeDevCommand": "npm run vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hilvox",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "rkanik",
    "shortDescription": "Hilvox - PUBG VOD to highlight shorts",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../config": "config",
      "../../models": "models",
      "../../scripts/ocr_frame.ps1": "scripts/ocr_frame.ps1",
      "../../augniik-character.png": "augniik-character.png",
      "../../augniik-cover.jpg": "augniik-cover.jpg",
      "../../augniik-profile.jpg": "augniik-profile.jpg"
    },
    "externalBin": [
      "binaries/highlight-engine",
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Hilvox",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {}
}
